{
  "name": "dark-cloud-companion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "plans": "vite-node --config vitest.config.ts scripts/planner/predefined.ts",
    "plans:force": "vite-node --config vitest.config.ts scripts/planner/predefined.ts --force",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run fmt && pnpm run lint:fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "playwright test",
    "test:all": "pnpm run check && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "highs": "^1.15.3",
    "lucide-react": "^1.52.0",
    "nanostores": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
