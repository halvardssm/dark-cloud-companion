---
import "../styles/global.css";
import { NavBar } from "@/components/NavBar";
import { useTranslations } from "@/i18n";

interface Props {
  title?: string;
}

const t = useTranslations();
const { title = t("app.name") } = Astro.props;
const pathname = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#171717" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <header class="border-b">
      <div class="mx-auto flex max-w-5xl items-center px-4 pt-3">
        <a href="/" class="font-semibold">{t("app.name")}</a>
      </div>
      <NavBar client:load pathname={pathname} />
    </header>
    <main class="mx-auto max-w-5xl px-4 py-6">
      <slot />
    </main>
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </body>
</html>
