---
import "../styles/global.css";
import { ThemeToggle } from "@/components/ThemeToggle";
import { ProfileSwitcher } from "@/components/ProfileSwitcher";
import { useTranslations } from "@/i18n";

interface Props {
  title?: string;
}

const t = useTranslations();
const { title = t("app.name") } = Astro.props;
const nav = [
  { href: "/chapters", label: t("nav.chapters") },
  { href: "/guides", label: t("nav.guides") },
  { href: "/planner", label: t("nav.planner") },
  { href: "/weapons", label: t("nav.weapons") },
  { href: "/ridepod", label: t("nav.ridepod") },
  { href: "/monsters", label: t("nav.monsters") },
  { href: "/spheda", label: t("nav.spheda") },
  { href: "/settings", label: t("nav.settings") },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#171717" />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <header class="border-b">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="font-semibold">{t("app.name")}</a>
        <div class="flex items-center gap-2">
          <ProfileSwitcher client:load />
          <ThemeToggle client:load label={t("theme.toggle")} />
        </div>
      </div>
      <nav class="mx-auto flex max-w-5xl gap-4 overflow-x-auto px-4 pb-2 text-sm">
        {nav.map((n) => <a href={n.href} class="text-muted-foreground hover:text-foreground whitespace-nowrap">{n.label}</a>)}
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-6">
      <slot />
    </main>
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </body>
</html>
