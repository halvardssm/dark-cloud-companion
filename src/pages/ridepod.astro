---
import Layout from "@/layouts/Layout.astro";
import { RidepodTracker } from "@/components/minigames/RidepodTracker";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("ridepod.title")} · ${t("app.name")}`}>
  <h1 class="mb-4 text-2xl font-semibold">{t("ridepod.title")}</h1>
  <RidepodTracker client:load />
</Layout>
