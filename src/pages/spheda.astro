---
import Layout from "@/layouts/Layout.astro";
import { SphedaTracker } from "@/components/minigames/SphedaTracker";
import { useTranslations } from "@/i18n";

const t = useTranslations();
---

<Layout title={`${t("spheda.title")} · ${t("app.name")}`}>
  <h1 class="mb-4 text-2xl font-semibold">{t("spheda.title")}</h1>
  <SphedaTracker client:load />
</Layout>
